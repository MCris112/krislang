// ===============================
// BOUNDARY TESTS
// ===============================
print("-- BOUNDARY TESTS --");

INT(1) $boundary1 = 1;         // Max for 1 bit: 1
print("INT(1) = 1 (max): OK");

INT(2) $boundary2 = 3;         // Max for 2 bits: 3 (11)
print("INT(2) = 3 (max): OK");

INT(3) $boundary3 = 7;         // Max for 3 bits: 7 (111)
print("INT(3) = 7 (max): OK");

INT(4) $boundary4 = 15;        // Max for 4 bits: 15 (1111)
print("INT(4) = 15 (max): OK");

INT(8) $boundary8 = 255;       // Max for 8 bits: 255
print("INT(8) = 255 (max): OK");

// ===============================
// EXPRESSIONS WITH CONSTRAINTS
// ===============================
print("-- EXPRESSIONS WITH CONSTRAINTS --");

INT(3) $expr1 = 1 + 2;         // 3 fits in 3 bits
print("INT(3) = 1+2: OK");

INT(4) $expr2 = 5 + 5;         // 10 fits in 4 bits
print("INT(4) = 5+5: OK");

//INT(3) $expr3 = 2 * 4;         // ERROR: 8 requires 4 bits
