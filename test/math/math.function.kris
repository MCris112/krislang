INT add(INT $x, INT $y) {
    return $x + $y;
}

INT mul(INT $x, INT $y) {
    return $x * $y;
}

INT square(INT $x) {
    return $x * $x;
}

INT max(INT $a, INT $b) {
    if ($a > $b) {
        return $a;
    } else {
        return $b;
    }
}

INT abs(INT $x) {
    if ($x < 0) {
        return -$x;
    } else {
        return $x;
    }
}

INT isEven(INT $x) {
    if ($x % 2 == 0) {
        return 1;
    } else {
        return 0;
    }
}

VOID main() {

    INT $a = 10;
    INT $b = 3;
    INT $c = -4;

    print("=== Functional Math Validation ===");

    // Simple function math
    print(add($a, $b));                 // 10 + 3 = 13
    print(mul($a, $b));                 // 10 * 3 = 30
    print(square($b));                  // 3 * 3 = 9

    // Nested function calls
    print(add(square($b), $a));         // (3*3) + 10 = 19
    print(mul(add($a, $b), 2));          // (10 + 3) * 2 = 26

    // Function + precedence
    print($a + mul($b, 2));             // 10 + (3 * 2) = 16
    print(mul($a + $b, 2));              // (10 + 3) * 2 = 26

    // Conditionals with math
    print(max($a, $b));                 // max(10, 3) = 10
    print(max($b, $a));                 // max(3, 10) = 10

    // Absolute value logic
    print(abs($c));                     // abs(-4) = 4
    print(abs($a - 15));                // abs(-5) = 5

    // Boolean math (Aristotelian predicates)
    print(isEven($a));                  // 10 is even → 1
    print(isEven($b));                  // 3 is odd → 0
    print(isEven($a + $b));             // 13 is odd → 0
    print(isEven($a * $b));             // 30 is even → 1

    // Aristotle‑style syllogism via math:
    // All even numbers are divisible by 2
    // 10 is even
    // Therefore 10 % 2 == 0
    if (isEven($a) == 1) {
        print($a % 2);                  // 0
    }

    // Complex composition
    print(
        add(
            square(add($b, 1)),
            mul(abs($c), 2)
        )
    );
    // square(3+1) + (4*2) = 16 + 8 = 24

    print("=== End Functional Validation ===");
}

main();
