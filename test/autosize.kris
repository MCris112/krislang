print("===== BIT SIZE CONSTRAINT TEST START =====");

// ===============================
// VALID DECLARATIONS
// ===============================
print("-- VALID DECLARATIONS --");

INT(1) $bit1 = 1;              // 1 requires 1 bit: 1
print("INT(1) = 1: OK");

INT(2) $bit2 = 3;              // 3 requires 2 bits: 11
print("INT(2) = 3: OK");

INT(3) $bit3 = 7;              // 7 requires 3 bits: 111
print("INT(3) = 7: OK");

INT(4) $bit4 = 15;             // 15 requires 4 bits: 1111
print("INT(4) = 15: OK");

INT(8) $bit8 = 255;            // 255 requires 8 bits: 11111111
print("INT(8) = 255: OK");

INT(1) $zero = 0;              // 0 requires 1 bit (edge case)
print("INT(1) = 0: OK");

