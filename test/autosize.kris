// ===============================
// VALID ASSIGNMENTS
// ===============================
print("-- VALID ASSIGNMENTS --");

INT(3) $num1 = 1;
$num1 = 7;                     // OK: 7 fits in 3 bits
print("INT(3) assign 7: OK");

INT(4) $num2 = 1;
$num2 = 15;                    // OK: 15 fits in 4 bits
print("INT(4) assign 15: OK");

INT(8) $num3 = 0;
$num3 = 100;                   // OK: 100 fits in 8 bits
print("INT(8) assign 100: OK");

